<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No windowSplashScreenIconBackgroundColor at all: setting it, even to
         transparent, makes some ROMs (notably MIUI) draw the icon inside a
         visible plate. Omitting it lets the mark sit directly on the window. -->
    <style name="Theme.Onvo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/onvo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_onvo</item>
        <item name="windowSplashScreenAnimationDuration">1200</item>
        <item name="postSplashScreenTheme">@style/Theme.Onvo</item>
    </style>
</resources>
