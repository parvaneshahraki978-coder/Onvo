<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Onvo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/onvo_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Onvo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/onvo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_onvo_splash_static</item>
        <item name="postSplashScreenTheme">@style/Theme.Onvo</item>
    </style>
</resources>
